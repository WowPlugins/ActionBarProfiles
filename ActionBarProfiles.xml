<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">

	<Button name="ActionBarProfiles_IconFrame" hidden="false" enableMouse="true" parent="Minimap" toplevel="true">
		<HighlightTexture alphaMode="ADD" file="Interface\Minimap\UI-Minimap-ZoomButton-Highlight"/>
		<Size><AbsDimension x="33" y="33"/></Size>
		<Anchors>
			<Anchor point="TOPLEFT" relativeTo="Minimap" relativePoint="TOPLEFT">
				<Offset><AbsDimension x="0" y="0"/></Offset>
			</Anchor>
		</Anchors>

		<Layers>
			<Layer level="OVERLAY">
				<Texture name="ActionBarProfiles_IconTexture" file="Interface\AddOns\ActionBarProfiles\Images\abp">
					<Size><AbsDimension x="26" y="26"/></Size>
					<Anchors>
						<Anchor point="CENTER"><Offset><AbsDimension x="0" y="0"/></Offset></Anchor>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>

		<Frames>
			<Frame name="ABP_DropDownMenu" inherits="UIDropDownMenuTemplate"/>
		</Frames>

		<Scripts>
			<OnLoad>
				ABP_OnLoad();
				this:RegisterForDrag("RightButton");
				this.dragme = false;
			</OnLoad>
			<OnEvent>
				ABP_OnEvent(event);
			</OnEvent>
			<OnClick>
				ToggleDropDownMenu(1, nil, ABP_DropDownMenu, "ActionBarProfiles_IconFrame", 0, 0);
			</OnClick>
			<OnUpdate>
				if (this.dragme == true) then
					ABPButton_BeingDragged();
				end
			</OnUpdate>
			<OnDragStart>
				this.dragme = true;
			</OnDragStart>
			<OnDragStop>
				this.dragme = false;
			</OnDragStop>
			<OnEnter>
				GameTooltip:SetOwner(this, "ANCHOR_LEFT");
				GameTooltip:SetText("技能栏动作条保存");
				GameTooltip:AddLine("左键设置,右键拖动这个按钮.");
				GameTooltipTextLeft1:SetTextColor(1, 1, 1);
				GameTooltip:Show();
			</OnEnter>
			<OnLeave>
				GameTooltip:Hide();
			</OnLeave>
	    </Scripts>
	</Button>

	<GameTooltip name="ABP_Tooltip" inherits="GameTooltipTemplate" frameStrata="TOOLTIP">
		<Anchors>
			<Anchor point="BOTTOM" relativePoint="TOP">
				<Offset><AbsDimension x="0" y="100"/></Offset>
			</Anchor>
		</Anchors>
		<Scripts>
			<OnLoad>
				this:SetOwner(UIParent, "ANCHOR_NONE");
			</OnLoad>
		</Scripts>
	</GameTooltip>

	<Frame name="ABP_PortableFrame" toplevel="true" movable="true" parent="UIParent" enableMouse="true" hidden="true">
		<Size>
			<AbsDimension x="580" y="450"/>
		</Size>
		<Anchors>
			<Anchor point="CENTER"/>
		</Anchors>
		<Backdrop bgFile="Interface\DialogFrame\UI-DialogBox-Background" edgeFile="Interface\DialogFrame\UI-DialogBox-Border" tile="true">
			<BackgroundInsets>
				<AbsInset left="8" right="8" top="10" bottom="10"/>
			</BackgroundInsets>
			<TileSize>
				<AbsValue val="32"/>
			</TileSize>
			<EdgeSize>
				<AbsValue val="32"/>
			</EdgeSize>
		</Backdrop>
		<Layers>
			<Layer level="ARTWORK">
				<Texture name="$parentHeaderTexture" file="Interface\DialogFrame\UI-DialogBox-Header">
					<Size>
						<AbsDimension x="256" y="64"/>
					</Size>
					<Anchors>
						<Anchor point="TOP">
							<Offset>
								<AbsDimension x="0" y="12"/>
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>
				<FontString name="$parentHeaderText" inherits="GameFontNormal" text="动作条配置 导入 / 导出">
					<Anchors>
						<Anchor point="TOP" relativeTo="$parentHeaderTexture">
							<Offset>
								<AbsDimension x="0" y="-14"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
				<FontString name="$parentHint" inherits="GameFontHighlightSmall" text="导出：字符串已全选，直接 Ctrl+C。导入：粘贴字符串后点“导入”。">
					<Size>
						<AbsDimension x="540" y="20"/>
					</Size>
					<Anchors>
						<Anchor point="TOPLEFT">
							<Offset>
								<AbsDimension x="22" y="-34"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<ScrollFrame name="ABP_PortableScroll" inherits="UIPanelScrollFrameTemplate">
				<Size>
					<AbsDimension x="520" y="330"/>
				</Size>
				<Anchors>
					<Anchor point="TOPLEFT">
						<Offset>
							<AbsDimension x="20" y="-56"/>
						</Offset>
					</Anchor>
				</Anchors>
				<ScrollChild>
					<Frame name="ABP_PortableScrollChild" enableMouse="true">
						<Size>
							<AbsDimension x="500" y="330"/>
						</Size>
						<Anchors>
							<Anchor point="TOPLEFT"/>
						</Anchors>
						<Frames>
							<EditBox name="ABP_PortableFrameEditBox" letters="999999" enableMouse="true" multiLine="true" autoFocus="false">
								<Size>
									<AbsDimension x="480" y="320"/>
								</Size>
								<Anchors>
									<Anchor point="TOPLEFT">
										<Offset>
											<AbsDimension x="5" y="0"/>
										</Offset>
									</Anchor>
								</Anchors>
								<Scripts>
									<OnTextChanged>
										ScrollingEdit_OnTextChanged(self, ABP_PortableScroll);
									</OnTextChanged>
									<OnCursorChanged>
										ScrollingEdit_OnCursorChanged(self, arg1, arg2-10, arg3, arg4);
									</OnCursorChanged>
									<OnEscapePressed>
										this:ClearFocus();
									</OnEscapePressed>
									<OnClick>
										this:SetFocus();
									</OnClick>
								</Scripts>
								<FontString inherits="GameFontHighlightSmall"/>
							</EditBox>
						</Frames>
					</Frame>
				</ScrollChild>
			</ScrollFrame>
			<Button name="$parentImportButton" inherits="GameMenuButtonTemplate" text="导入">
				<Size>
					<AbsDimension x="125" y="25"/>
				</Size>
				<Anchors>
					<Anchor point="BOTTOM">
						<Offset>
							<AbsDimension x="-160" y="15"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						ABP_Portable_Import();
					</OnClick>
				</Scripts>
			</Button>
			<Button name="$parentCloseButton" inherits="GameMenuButtonTemplate" text="关闭">
				<Size>
					<AbsDimension x="125" y="25"/>
				</Size>
				<Anchors>
					<Anchor point="BOTTOM">
						<Offset>
							<AbsDimension x="160" y="15"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						ABP_PortableFrame:Hide();
					</OnClick>
				</Scripts>
			</Button>
		</Frames>
	</Frame>
</Ui>
